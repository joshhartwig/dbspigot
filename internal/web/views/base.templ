package views

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<style>
				@import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap");
				:root {
					--bg: #0b0c0d;
					--bg-2: #0f1113;
					--panel: #14171a;
					--panel-2: #1b1f23;
					--accent: #28f2a4;
					--accent-2: #19c18a;
					--text: #e6e9ee;
					--muted: #9aa0a6;
					--border: #273037;
					--shadow: rgba(0, 0, 0, 0.45);
				}
				* {
					box-sizing: border-box;
				}
				html, body {
					margin: 0;
					padding: 0;
				}
				body {
					font-family: "Space Grotesk", "Segoe UI", sans-serif;
					min-height: 100vh;
					background: radial-gradient(circle at 15% 20%, rgba(40, 242, 164, 0.08), transparent 45%),
						radial-gradient(circle at 85% 10%, rgba(39, 111, 255, 0.12), transparent 40%),
						linear-gradient(180deg, var(--bg), var(--bg-2));
					color: var(--text);
				}
				main {
					max-width: 1100px;
					margin: 0 auto;
					padding: 48px 28px 80px;
				}
				h1, h2, h3 {
					font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, monospace;
					font-weight: 600;
					letter-spacing: -0.01em;
				}
				.btn {
					display: inline-flex;
					align-items: center;
					gap: 10px;
					background: transparent;
					color: var(--text);
					border: none;
					padding: 12px 18px;
					cursor: pointer;
					font-size: 14px;
					font-weight: 600;
					border-radius: 10px;
					transition: all 180ms ease;
					text-decoration: none;
				}
				.btn-primary {
					background: linear-gradient(135deg, var(--accent), #45ffd0);
					color: #08110b;
					box-shadow: 0 12px 30px rgba(40, 242, 164, 0.2);
				}
				.btn-primary:hover {
					transform: translateY(-1px);
					box-shadow: 0 16px 34px rgba(40, 242, 164, 0.28);
				}
				.btn-ghost {
					border: 1px solid var(--border);
					background: rgba(18, 22, 25, 0.6);
				}
				.btn-ghost:hover {
					border-color: var(--accent-2);
					color: var(--accent);
				}
				.btn-danger {
					background: transparent;
					color: #ff7b7b;
					border: 1px solid rgba(255, 123, 123, 0.4);
				}
				.btn-danger:hover {
					background: rgba(255, 123, 123, 0.12);
					border-color: rgba(255, 123, 123, 0.7);
				}
				.topbar {
					display: flex;
					justify-content: space-between;
					align-items: center;
					gap: 16px;
					margin-bottom: 24px;
				}
				.brand {
					display: inline-flex;
					align-items: center;
					gap: 12px;
					font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, monospace;
					font-weight: 600;
					font-size: 18px;
					letter-spacing: 0.02em;
				}
				.logo {
					width: 34px;
					height: 34px;
					border-radius: 10px;
					border: 1px solid rgba(40, 242, 164, 0.6);
					display: grid;
					place-items: center;
					color: var(--accent);
					font-size: 18px;
					box-shadow: inset 0 0 12px rgba(40, 242, 164, 0.2);
				}
				.hero {
					display: grid;
					grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
					gap: 36px;
					align-items: center;
					margin-bottom: 56px;
				}
				.hero h1 {
					font-size: 40px;
					margin: 10px 0 12px;
				}
				.hero p {
					color: var(--muted);
					font-size: 16px;
					line-height: 1.6;
				}
				.hero-actions {
					display: flex;
					gap: 16px;
					flex-wrap: wrap;
					margin-top: 24px;
				}
				.eyebrow {
					display: inline-flex;
					align-items: center;
					gap: 8px;
					font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, monospace;
					font-size: 13px;
					color: var(--accent);
					text-transform: uppercase;
					letter-spacing: 0.18em;
				}
				.terminal {
					background: linear-gradient(180deg, var(--panel), var(--panel-2));
					border: 1px solid rgba(40, 242, 164, 0.35);
					border-radius: 18px;
					box-shadow: 0 30px 60px var(--shadow);
					overflow: hidden;
				}
				.terminal-head {
					display: flex;
					align-items: center;
					gap: 16px;
					padding: 14px 18px;
					background: rgba(12, 16, 18, 0.75);
					border-bottom: 1px solid rgba(255, 255, 255, 0.06);
					font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, monospace;
					color: var(--muted);
					font-size: 12px;
					text-transform: uppercase;
				}
				.terminal-icon {
					color: var(--text);
					font-size: 14px;
				}
				.terminal-tabs {
					display: flex;
					gap: 12px;
					flex-wrap: wrap;
				}
				.terminal-tab {
					padding: 4px 10px;
					border-radius: 8px;
					background: rgba(255, 255, 255, 0.05);
					color: #cfd4da;
				}
				.terminal-tab.active {
					background: rgba(40, 242, 164, 0.2);
					color: var(--accent);
				}
				.terminal-subhead {
					display: flex;
					align-items: center;
					gap: 10px;
					padding: 12px 18px;
					border-bottom: 1px solid rgba(255, 255, 255, 0.06);
					font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, monospace;
					color: var(--muted);
				}
				.terminal-subhead .dot {
					width: 10px;
					height: 10px;
					border-radius: 50%;
					background: rgba(255, 255, 255, 0.15);
				}
				.terminal-body {
					padding: 22px;
					font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, monospace;
					color: #d6dbe1;
					font-size: 13px;
					line-height: 1.7;
					white-space: pre-wrap;
					margin: 0;
				}
				.terminal-body .comment {
					color: #7f8792;
				}
				.terminal-body .accent {
					color: var(--accent);
				}
				.section-title {
					display: flex;
					align-items: center;
					gap: 12px;
					margin: 48px 0 16px;
					font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, monospace;
					font-size: 18px;
				}
				.section-title span {
					color: var(--accent);
				}
				.table-wrap {
					background: rgba(13, 16, 18, 0.72);
					border: 1px solid var(--border);
					border-radius: 16px;
					padding: 10px;
				}
				table {
					width: 100%;
					border-collapse: collapse;
					font-size: 14px;
				}
				th, td {
					text-align: left;
					padding: 14px 12px;
					border-bottom: 1px solid rgba(255, 255, 255, 0.05);
				}
				th {
					font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, monospace;
					font-size: 12px;
					letter-spacing: 0.1em;
					text-transform: uppercase;
					color: var(--muted);
				}
				tr:hover {
					background: rgba(255, 255, 255, 0.02);
				}
				.conn-string {
					font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, monospace;
					font-size: 12px;
					background: rgba(255, 255, 255, 0.06);
					padding: 6px 8px;
					border-radius: 8px;
					word-break: break-all;
				}
				.empty {
					text-align: center;
					padding: 48px 20px;
					color: var(--muted);
					background: rgba(13, 16, 18, 0.72);
					border: 1px dashed var(--border);
					border-radius: 16px;
				}
				@keyframes floatIn {
					from { opacity: 0; transform: translateY(12px); }
					to { opacity: 1; transform: translateY(0); }
				}
				.hero > * {
					animation: floatIn 420ms ease forwards;
				}
				@media (max-width: 760px) {
					main {
						padding: 36px 20px 60px;
					}
					.topbar {
						flex-direction: column;
						align-items: flex-start;
					}
					.hero h1 {
						font-size: 32px;
					}
				}
			</style>
		</head>
		<body>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
