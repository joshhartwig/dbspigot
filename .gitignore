# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Output of the go coverage tool, specifically when used with LiteIDE
*.cov

# Dependency directories (remove the comment below if you use Go modules)
/vendor/

# Go workspace file
*.code-workspace

# IDE/editor directories and files
.idea/
.vscode/
*.swp
*~

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Docker
*.pid

# Ignore build and temp directories
/build/
/tmp/

# Ignore node_modules if any frontend work
node_modules/

# Ignore environment files
.env
.env.*
